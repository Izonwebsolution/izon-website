# Copy this file to .env.local and fill in real values.
# Nothing here is required for the site to run locally.

# Your production domain, once connected in Vercel (used for SEO metadata).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to skip.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification code. Leave blank to skip.
NEXT_PUBLIC_GSC_VERIFICATION=
